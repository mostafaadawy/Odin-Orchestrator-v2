=== BACKEND captcha service: which token it reads first (lines 50-67) ===
    }
  }

  private challengeTokens(input: CaptchaEvaluationInput) {
    const record = this.readTokenRecord(input.challengeToken);
    const providerToken =
      this.tokenString(record?.providerToken) ||
      this.tokenString(record?.captchaToken) ||
      this.tokenString(input.captchaToken) ||
      this.tokenString(input.challengeToken);
    const puzzleToken =
      this.tokenString(record?.puzzleToken) ||
      this.tokenString(record?.securityPuzzleToken) ||
      this.tokenString(input.puzzleToken) ||
      this.tokenString(input.securityPuzzleToken) ||
      this.tokenString(input.challengeProof);
    return { providerToken, puzzleToken };
  }

