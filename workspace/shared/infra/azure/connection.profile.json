  "procedure": {
    "runbook": "workspace/shared/runbooks/azure-secure-connection.md",
    "dynamicIp": true,
    "sshSingleIpAtATime": true,
    "ipUpdatedInTwoPlaces": [
      "VM OS firewall via Serial Console",
      "Azure NSG SSH inbound source IP"
    ],
    "serviceManager": "systemd",
    "notPm2": true,
    "syncMethod": "scp (local -> Azure)",
    "reverseProxy": "yes (handle on rebuild)",
    "folderMapping": [
      {
        "local": "frontend/RBO-Staging/f",
        "azure": "~/RBO-Staging/f",
        "note": "VM home folder"
      },
      {
        "local": "backend/RBO-Staging/b",
        "azure": "~/RBO-Staging/b",
        "note": "VM home folder"
      }
    ]
  },
  "policy": {
    "everyCommandApprovalGated": true,
    "respectClosedPorts": true,
    "respectIpAllowlist": true,
    "respectExistingSyncMethod": true,
    "neverWidenExposureWithoutApproval": true,
    "autoReadOnlyAllowed": [
      "detect public IP",
      "ssh reachability",
      "health checks",
      "log reads"
    ],
    "manualOnly": [
      "Azure Serial Console login",
      "Azure NSG Portal edits"
