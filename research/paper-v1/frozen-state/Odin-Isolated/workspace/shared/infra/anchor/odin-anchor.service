# systemd unit so the Anchor container starts on boot and is kept alive.
#   sudo cp infra/anchor/odin-anchor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now odin-anchor
[Unit]
Description=Odin Anchor (standalone queue/auth/webhook service)
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# adjust to wherever you checked the repo out on the VM
WorkingDirectory=/home/mostafa/odin/infra/anchor
ExecStartPre=/usr/bin/docker compose pull --ignore-pull-failures
ExecStart=/usr/bin/docker compose up --build
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
