{
  "name": "odin-desktop",
  "version": "1.0.0",
  "description": "Odin-Orchestrator — premium desktop cockpit (Electron + React + Vite + Framer Motion)",
  "author": "Odin AI Systems",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && ODIN_DEV=1 ELECTRON_ENABLE_LOGGING=1 electron .\"",
    "build": "vite build",
    "dist": "VITE_ODIN_ENV=production vite build && electron-builder --mac dmg",
    "pack": "npm run build && electron-builder --dir",
    "e2e": "python3 ../tests/e2e.py",
    "e2e:quick": "python3 ../tests/e2e.py --quick",
    "vite": "vite",
    "electron": "electron ."
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "ai.odin.orchestrator",
    "productName": "Odin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Odin ${version}"
    },
    "afterPack": "./build/afterpack-sign.cjs"
  }
}
