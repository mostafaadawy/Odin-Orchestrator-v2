#!/bin/bash
# Transparent wrapper: runs the real Claude Code CLI, then records cost/tokens/duration of the call (for the cost ledger).
LOG="${CLAUDE_CALL_LOG:-/Users/mostafaadawy/Desktop/AiAgentWorkSpace/Odin-Isolated/_research/results/claude_calls.jsonl}"
TMP=$(mktemp -t ccall); T0=$(/usr/bin/python3 -c 'import time;print(time.time())')
/opt/homebrew/bin/claude "$@" | tee "$TMP"; RC=${PIPESTATUS[0]}
/usr/bin/python3 - "$TMP" "$LOG" "$T0" "$PWD" "$RC" "$*" <<'PY' 2>/dev/null
import sys, json, time
tmp, log, t0, cwd, rc, args = sys.argv[1:7]
res = None
for line in open(tmp, errors="ignore"):
    line = line.strip()
    if '"total_cost_usd"' in line:
        try: res = json.loads(line)
        except Exception: pass
m = None; a = args.split()
if "--model" in a:
    i = a.index("--model"); m = a[i + 1] if i + 1 < len(a) else None
rec = {"t_start": float(t0), "t_end": time.time(), "cwd": cwd, "rc": int(rc), "model_flag": m,
       "cost_usd": (res or {}).get("total_cost_usd"), "duration_ms": (res or {}).get("duration_ms"),
       "duration_api_ms": (res or {}).get("duration_api_ms"), "num_turns": (res or {}).get("num_turns"),
       "usage": (res or {}).get("usage"), "is_error": (res or {}).get("is_error")}
open(log, "a").write(json.dumps(rec) + "\n")
PY
rm -f "$TMP"; exit $RC
