# Odin-Orchestrator — never commit secrets or local junk.

# --- Secrets / keys (defense against leaks) ---
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
*_key
*_key.*
*.p12
*.pfx
.env
.env.*
*.secret
secrets/
**/authorized_keys
**/known_hosts

# --- Python / build ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# --- Desktop app (Electron/React) build artifacts — never commit these ---
node_modules/
desktop/node_modules/
desktop/dist/
desktop/release/
dist/
*.dmg
*.app/
*.asar

# --- OS / editor ---
.DS_Store
*.swp

# NOTE: SSH private keys must live in ~/.ssh, NOT in this project. Odin references the key by
# path only (keyPath in infra/azure/connection.profile.json). The private key is never stored here.

# Persistent chat transcripts (may contain sensitive content)
chats/

# Runtime data (projects, scopes, schedules, models)
data/

# local credentials (never commit)
oth/
.cred
*.log

# credentials (never commit)
**/.cred
**/.auth
workspace/shared/oth/
workspace/shared/core-registry/connector_keys.json

# v2 program: isolated test clone (rebuilt by _v2/iso/build_iso.py)
_v2/iso_root/
_v2/*.log
# paper-v1 frozen state: generated anchor js may carry the pre-rotation Anchor key (rotated at cutover) - kept on disk for the fingerprint, never in git
research/paper-v1/frozen-state/Odin-Isolated/anchor_prod.js
research/paper-v1/frozen-state/Odin-Isolated/anchor_seed.js
research/phase4/cache/
research/phase4/models/

# F-14: generated at run time by shells/*_full_checker.sh from oth/.cred - they carry the anchor key
/anchor_prod.js
/anchor_seed.js
workspace/anchor-layer/anchor_seed.js
# v2 suite: keep summaries in git, not the raw per-test logs
_v2/results/*/logs/
_v2/results/*/build_iso.log
_v2/suite_*.log
_v2/cutover/backup_*/
_v2/cutover/LAST_BACKUP
_v2/cutover/db_backups/
_v2/cutover/vm_logs_report.txt
_archive/
# never publish: rotation/edit backups + raw v1 bundles (hold credential values)
*.bak_*
docs/program/_phase1_bundles/*.tgz
docs/program/_phase1_bundles/v1_chats.tgz
docs/program/_phase1_bundles/v1_source.tgz

# ===== v2 hardening (14 Oct) — never publish these =====
_archive/
.cred*
**/.cred*
*.cred.bak*
*.bak_*
docs/program/_phase1_bundles/
v1_chats.tgz
v1_source.tgz
_v2/iso_root/
# build outputs
**/build/
# desktop/build holds the app icon + signing hook (source, not output)
!desktop/build/
!research/paper-v1/frozen-state/Odin-Isolated/desktop/build/
**/.dart_tool/
**/.gradle/
**/Pods/
odin_app/ios/Flutter/ephemeral/
desktop/dist/
desktop/release/
**/node_modules/
**/__pycache__/
# editor
.vscode/
.DS_Store
